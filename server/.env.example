# Whoop datastore + ingest. Copy to .env and fill in. Do NOT commit .env.
# Bearer token the uploader/phone must send (Authorization: Bearer <this>).
WHOOP_API_KEY=change_me
# TimescaleDB credentials (whoop-db container).
WHOOP_DB_NAME=whoop
WHOOP_DB_USER=whoop
WHOOP_DB_PASSWORD=change_me
# Host port the ingest API is published on (container listens on 8000).
WHOOP_INGEST_PORT=8770
# Optional: Claude-powered insights + chat over your own metrics (/v1/insights, /v1/chat).
# Leave ANTHROPIC_API_KEY blank to disable those endpoints (they return 503). The server
# needs outbound access to api.anthropic.com when this is set. Model is overridable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
